{
  "name": "@2869949486/dsh-opencode-usage",
  "version": "1.0.0",
  "type": "module",
  "description": "dsh plugin: per-model OpenCode Go usage and remaining allowance in a Settings page.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "opencode",
    "usage",
    "billing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2869949486/dsh-opencode-usage.git"
  },
  "homepage": "https://github.com/2869949486/dsh-opencode-usage#readme",
  "bugs": {
    "url": "https://github.com/2869949486/dsh-opencode-usage/issues"
  },
  "engines": {
    "dsh": "^0.2.0-rc.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
